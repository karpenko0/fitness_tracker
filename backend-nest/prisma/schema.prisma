generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  PENDING_DELETION
  DELETED
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
  HEALTH
  STRENGTH
  FLEXIBILITY
  ENDURANCE
  MOBILITY_RECOVERY
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingLocation {
  GYM
  HOME
  OUTDOOR
  MIXED
}

model User {
  id                    String       @id @default(uuid())
  telegramId            BigInt       @unique
  telegramUsername      String?      @db.VarChar(255)
  firstName             String       @db.VarChar(255)
  lastName              String?      @db.VarChar(255)
  telegramLanguageCode  String?      @db.VarChar(16)
  telegramPhotoUrl      String?
  status                UserStatus   @default(ACTIVE)
  lastLoginAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?
  profile               UserProfile?
  roles                 UserRole[]
  assignedRoles         UserRole[]    @relation("assignedByUser")
  authSessions          AuthSession[]
  auditLogs             AuditLog[]    @relation("actorUser")
  auditTargets          AuditLog[]    @relation("targetUser")
  onboardingDrafts      OnboardingDraft[]
  programAssignments    UserProgramAssignment[]
  workouts              Workout[]
  notifications         Notification[]
  idempotencyKeys       IdempotencyKey[]
  outboxEvents           OutboxEvent[]
}

model UserProfile {
  id                     String            @id @default(uuid())
  user                   User              @relation(fields: [userId], references: [id])
  userId                 String            @unique
  gender                 Gender?
  birthDate              DateTime?
  heightCm               Int?
  weightKg               Decimal?          @db.Decimal(5, 1)
  fitnessGoal            FitnessGoal?
  experienceLevel        ExperienceLevel?
  trainingLocation       TrainingLocation?
  trainingFrequency      Int?
  preferredWorkoutDuration Int?
  equipment              Json              @default("[]")
  limitations            String?
  trainingPreferences    Json              @default("[]")
  nutritionPlanNeeded    Boolean           @default(false)
  notificationDays       Json              @default("[]")
  notificationTime       String?
  locale                 String            @default("ru")
  timezone               String            @default("UTC")
  onboardingCompleted    Boolean           @default(false)
  onboardingCompletedAt  DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

enum OnboardingDraftStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}
enum OnboardingStep {
  GOAL
  TRAINING_CONTEXT
  EXPERIENCE
  BODY_DATA
  EQUIPMENT
  LIMITATIONS
  REMINDERS
  NUTRITION
  REVIEW
}
enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum AssignmentSource {
  ONBOARDING
  ADMIN
  TRAINER
  USER
}
enum AssignmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}
enum WorkoutStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum WorkoutSource {
  ONBOARDING
  USER
  SYSTEM
}
enum NotificationType {
  WORKOUT_REMINDER
}
enum NotificationStatus {
  ACTIVE
  PAUSED
  DISABLED
}
enum NotificationSource {
  ONBOARDING
  SYSTEM
}

model OnboardingDraft {
  id             String                @id @default(uuid())
  user           User                  @relation(fields: [userId], references: [id])
  userId         String
  status         OnboardingDraftStatus @default(IN_PROGRESS)
  currentStep    OnboardingStep        @default(GOAL)
  completedSteps Json                  @default("[]")
  draftData      Json                  @default("{}")
  version        Int                   @default(1)
  expiresAt      DateTime
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([updatedAt])
}

model StarterProgram {
  id                String                  @id @default(uuid())
  title             String
  status            ProgramStatus           @default(DRAFT)
  active            Boolean                 @default(true)
  goals             Json                    @default("[]")
  levels            Json                    @default("[]")
  locations         Json                    @default("[]")
  workoutsPerWeek   Int
  durationMinutes   Int
  requiredEquipment Json                    @default("[]")
  contraindications Json                    @default("[]")
  firstWorkoutTitle String                  @default("Тренировка 1")
  isFallback        Boolean                 @default(false)
  assignments       UserProgramAssignment[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, active])
}

model UserProgramAssignment {
  id        String             @id @default(uuid())
  user      User               @relation(fields: [userId], references: [id])
  userId    String
  program   StarterProgram     @relation(fields: [programId], references: [id])
  programId String
  source    AssignmentSource
  status    AssignmentStatus   @default(ACTIVE)
  startedAt DateTime           @default(now())
  createdAt DateTime           @default(now())
  workouts  Workout[]

  @@unique([userId, programId, source])
  @@index([userId, status])
}

model Workout {
  id                  String                @id @default(uuid())
  user                User                  @relation(fields: [userId], references: [id])
  userId              String
  programAssignment   UserProgramAssignment @relation(fields: [programAssignmentId], references: [id])
  programAssignmentId String
  status              WorkoutStatus         @default(PLANNED)
  source              WorkoutSource
  scheduledFor        DateTime
  title               String
  createdAt           DateTime              @default(now())

  @@unique([programAssignmentId, scheduledFor])
  @@index([userId, scheduledFor])
}

model Notification {
  id           String              @id @default(uuid())
  user         User                @relation(fields: [userId], references: [id])
  userId       String
  type         NotificationType
  scheduleDays Json
  scheduleTime String
  timezone     String
  status       NotificationStatus  @default(ACTIVE)
  source       NotificationSource
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([userId, type, source])
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([userId, key])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?
  type        String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
}

model Role {
  id          String     @id @default(uuid())
  code        String     @unique @db.VarChar(64)
  name        String     @db.VarChar(128)
  description String?
  createdAt   DateTime   @default(now())
  userRoles   UserRole[]
}

model UserRole {
  userId        String
  roleId        String
  assignedById  String?
  createdAt     DateTime   @default(now())

  user          User       @relation(fields: [userId], references: [id])
  role          Role       @relation(fields: [roleId], references: [id])
  assignedBy    User?      @relation("assignedByUser", fields: [assignedById], references: [id])

  @@id([userId, roleId])
}

model AuthSession {
  id               String    @id @default(uuid())
  user             User      @relation(fields: [userId], references: [id])
  userId           String
  refreshTokenHash String    @db.VarChar(255)
  ipHash           String?   @db.VarChar(255)
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?   @db.VarChar(128)
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([refreshTokenHash])
}

model AuditLog {
  id            String    @id @default(uuid())
  actorUserId   String?   
  targetUserId  String?
  action        String    @db.VarChar(128)
  entityType    String    @db.VarChar(128)
  entityId      String?
  metadata      Json      @default("{}")
  requestId     String?   @db.VarChar(128)
  ipHash        String?   @db.VarChar(255)
  createdAt     DateTime  @default(now())

  actorUser     User?     @relation("actorUser", fields: [actorUserId], references: [id])
  targetUser    User?     @relation("targetUser", fields: [targetUserId], references: [id])
}
