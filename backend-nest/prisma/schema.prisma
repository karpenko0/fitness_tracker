generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  PENDING_DELETION
  DELETED
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
  HEALTH
  STRENGTH
  FLEXIBILITY
  ENDURANCE
  MOBILITY_RECOVERY
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingLocation {
  GYM
  HOME
  OUTDOOR
  MIXED
}

model User {
  id                    String       @id @default(uuid())
  telegramId            BigInt       @unique
  telegramUsername      String?      @db.VarChar(255)
  firstName             String       @db.VarChar(255)
  lastName              String?      @db.VarChar(255)
  telegramLanguageCode  String?      @db.VarChar(16)
  telegramPhotoUrl      String?
  status                UserStatus   @default(ACTIVE)
  lastLoginAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?
  profile               UserProfile?
  roles                 UserRole[]
  assignedRoles         UserRole[]    @relation("assignedByUser")
  authSessions          AuthSession[]
  auditLogs             AuditLog[]    @relation("actorUser")
  auditTargets          AuditLog[]    @relation("targetUser")
  onboardingDrafts      OnboardingDraft[]
  programAssignments    UserProgramAssignment[]
  workouts              Workout[]
  dashboardSnapshots    DashboardSnapshot[]
  dailyStates           UserDailyState[]
  notifications         Notification[]
  measurements          Measurement[]
  idempotencyKeys       IdempotencyKey[]
  outboxEvents           OutboxEvent[]
}

model UserProfile {
  id                     String            @id @default(uuid())
  user                   User              @relation(fields: [userId], references: [id])
  userId                 String            @unique
  gender                 Gender?
  birthDate              DateTime?
  heightCm               Int?
  weightKg               Decimal?          @db.Decimal(5, 1)
  fitnessGoal            FitnessGoal?
  experienceLevel        ExperienceLevel?
  trainingLocation       TrainingLocation?
  trainingFrequency      Int?
  preferredWorkoutDuration Int?
  equipment              Json              @default("[]")
  limitations            String?
  trainingPreferences    Json              @default("[]")
  nutritionPlanNeeded    Boolean           @default(false)
  notificationDays       Json              @default("[]")
  notificationTime       String?
  locale                 String            @default("ru")
  timezone               String            @default("UTC")
  onboardingCompleted    Boolean           @default(false)
  onboardingCompletedAt  DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

enum OnboardingDraftStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}
enum OnboardingStep {
  GOAL
  TRAINING_CONTEXT
  EXPERIENCE
  BODY_DATA
  EQUIPMENT
  LIMITATIONS
  REMINDERS
  NUTRITION
  REVIEW
}
enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum AssignmentSource {
  ONBOARDING
  ADMIN
  TRAINER
  USER
}
enum AssignmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}
enum WorkoutStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  MISSED
  CANCELLED
  ABANDONED
}

enum DashboardSnapshotStatus {
  ACTIVE
  INVALIDATED
  EXPIRED
}

enum DashboardDayState {
  ONBOARDING_REQUIRED
  WORKOUT_IN_PROGRESS
  WORKOUT_PLANNED
  REST_DAY
  PROGRAM_REQUIRED
  WORKOUT_MISSED
}

enum DashboardPrimaryActionType {
  RESUME_WORKOUT
  CONTINUE_ONBOARDING
  START_WORKOUT
  RESCHEDULE_WORKOUT
  VIEW_PROGRAM
  CHOOSE_PROGRAM
  REST_DAY
}
enum WorkoutSource {
  PROGRAM
  TEMPLATE
  MANUAL
  ONBOARDING
  USER
  SYSTEM
}
enum NotificationType {
  WORKOUT_REMINDER
}
enum NotificationStatus {
  ACTIVE
  PAUSED
  DISABLED
}
enum NotificationSource {
  ONBOARDING
  SYSTEM
}

model OnboardingDraft {
  id             String                @id @default(uuid())
  user           User                  @relation(fields: [userId], references: [id])
  userId         String
  status         OnboardingDraftStatus @default(IN_PROGRESS)
  currentStep    OnboardingStep        @default(GOAL)
  completedSteps Json                  @default("[]")
  draftData      Json                  @default("{}")
  version        Int                   @default(1)
  expiresAt      DateTime
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([updatedAt])
}

model StarterProgram {
  id                String                  @id @default(uuid())
  title             String
  status            ProgramStatus           @default(DRAFT)
  active            Boolean                 @default(true)
  goals             Json                    @default("[]")
  levels            Json                    @default("[]")
  locations         Json                    @default("[]")
  workoutsPerWeek   Int
  durationMinutes   Int
  requiredEquipment Json                    @default("[]")
  contraindications Json                    @default("[]")
  firstWorkoutTitle String                  @default("Тренировка 1")
  isFallback        Boolean                 @default(false)
  assignments       UserProgramAssignment[]
  workouts         ProgramWorkout[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, active])
}

model ProgramWorkout {
  id        String           @id @default(uuid())
  program   StarterProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String
  title     String
  position  Int
  exercises ProgramWorkoutExercise[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([programId, position])
}

model ExerciseCatalogItem {
  id           String   @id @default(uuid())
  title        String
  muscleGroup  String
  movementType String?
  equipment    String?
  difficulty   String?
  techniqueUrl String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  programExercises ProgramWorkoutExercise[]
}

model ProgramWorkoutExercise {
  id               String              @id @default(uuid())
  programWorkout   ProgramWorkout      @relation(fields: [programWorkoutId], references: [id], onDelete: Cascade)
  programWorkoutId String
  exercise         ExerciseCatalogItem @relation(fields: [exerciseId], references: [id])
  exerciseId       String
  position         Int
  plannedSets      Json                @default("[]")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([programWorkoutId, position])
}

model WorkoutTemplate {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  locked    Boolean  @default(false)
  exercises Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model UserProgramAssignment {
  id        String             @id @default(uuid())
  user      User               @relation(fields: [userId], references: [id])
  userId    String
  program   StarterProgram     @relation(fields: [programId], references: [id])
  programId String
  source    AssignmentSource
  status    AssignmentStatus   @default(ACTIVE)
  startedAt DateTime           @default(now())
  rescheduleMissedWorkouts Boolean @default(false)
  createdAt DateTime           @default(now())
  workouts  Workout[]

  @@unique([userId, programId, source])
  @@index([userId, status])
}

model Workout {
  id                  String                @id @default(uuid())
  user                User                  @relation(fields: [userId], references: [id])
  userId              String
  programAssignment   UserProgramAssignment? @relation(fields: [programAssignmentId], references: [id])
  programAssignmentId String?
  status              WorkoutStatus         @default(PLANNED)
  source              WorkoutSource
  scheduledFor        DateTime
  title               String
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  durationSeconds     Int?
  totalVolumeKg       Decimal?              @db.Decimal(12, 2)
  templateId          String?
  pausedDurationSeconds Int                 @default(0)
  estimatedDurationMinutes Int?
  version             Int                   @default(1)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  sessions            WorkoutSession[]
  exercises           WorkoutExercise[]
  restTimer           WorkoutRestTimer?
  replacements        WorkoutExerciseReplacement[]

  @@unique([programAssignmentId, scheduledFor])
  @@index([userId, scheduledFor])
  @@index([userId, status, startedAt])
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum WorkoutExerciseKind {
  STRENGTH
  CARDIO
  MOBILITY
  OTHER
}

enum WorkoutExerciseStatus {
  ACTIVE
  REPLACED
  REMOVED
}

enum WorkoutSetType {
  WARMUP
  WORKING
  DROP_SET
  FAILURE
  CUSTOM
}

enum WorkoutSkipReason {
  NO_TIME
  TOO_HEAVY
  PAIN_OR_DISCOMFORT
  EQUIPMENT_UNAVAILABLE
  USER_DECISION
  OTHER
}

enum WorkoutRestTimerStatus {
  RUNNING
  PAUSED
  SKIPPED
  COMPLETED
}

enum WorkoutSetStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

model WorkoutSession {
  id                String               @id @default(uuid())
  workout           Workout              @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId         String               @unique
  status            WorkoutSessionStatus @default(IN_PROGRESS)
  startedAt         DateTime             @default(now())
  pausedAt          DateTime?
  completedAt       DateTime?
  durationSeconds   Int?
  version           Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, startedAt])
}

model WorkoutExercise {
  id                String               @id @default(uuid())
  workout           Workout              @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId         String
  title             String
  kind              WorkoutExerciseKind @default(STRENGTH)
  status            WorkoutExerciseStatus @default(ACTIVE)
  muscleGroup       String?
  equipment         String?
  catalogExerciseId String?
  techniqueUrl      String?
  recommendedWeightKg Decimal?           @db.Decimal(7, 2)
  lastPerformance   Json?
  replacedByExerciseId String?
  note              String?              @db.VarChar(500)
  position          Int
  completedAt       DateTime?
  version           Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sets              WorkoutSet[]

  @@unique([workoutId, position])
  @@index([workoutId, position])
}

model WorkoutExerciseReplacement {
  id                    String          @id @default(uuid())
  workout               Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId             String
  originalExerciseId    String
  replacementExerciseId String
  createdAt             DateTime        @default(now())
  @@index([workoutId, originalExerciseId])
}

model WorkoutSet {
  id                String           @id @default(uuid())
  exercise          WorkoutExercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId        String
  position          Int
  setType           WorkoutSetType   @default(WORKING)
  status            WorkoutSetStatus @default(PLANNED)
  plannedReps       Int?
  plannedWeightKg   Decimal?         @db.Decimal(7, 2)
  actualReps        Int?
  actualWeightKg    Decimal?         @db.Decimal(7, 2)
  rpe               Decimal?         @db.Decimal(3, 1)
  rir               Int?
  restSeconds       Int               @default(0)
  skipReason        WorkoutSkipReason?
  note              String?          @db.VarChar(500)
  reps              Int?
  weightKg          Decimal?         @db.Decimal(7, 2)
  durationSeconds   Int?
  completedAt       DateTime?
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([exerciseId, position])
  @@index([exerciseId, status])
}

model WorkoutRestTimer {
  id          String                 @id @default(uuid())
  workout     Workout                @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId   String                 @unique
  status      WorkoutRestTimerStatus @default(RUNNING)
  durationSeconds Int
  endsAt      DateTime?
  pausedRemainingSeconds Int?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model Measurement {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  weightKg  Decimal? @db.Decimal(5, 1)
  measuredAt DateTime @default(now())
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, measuredAt])
}

model DashboardSnapshot {
  id              String                  @id @default(uuid())
  userId          String
  localDate       DateTime                @db.Date
  timezone        String                  @db.VarChar(64)
  locale          String                  @db.VarChar(8)
  algorithmVersion String                 @db.VarChar(32)
  snapshotData    Json
  sourceVersion   BigInt
  version         Int                     @default(1)
  status          DashboardSnapshotStatus @default(ACTIVE)
  generatedAt     DateTime
  expiresAt       DateTime
  invalidatedAt   DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate, timezone, locale, algorithmVersion])
  @@index([userId, status, expiresAt])
  @@index([expiresAt])
}

model UserDailyState {
  id                   String                    @id @default(uuid())
  userId               String
  localDate            DateTime                  @db.Date
  timezone             String                    @db.VarChar(64)
  state                DashboardDayState
  primaryActionType    DashboardPrimaryActionType
  activeWorkoutId      String?
  plannedWorkoutId     String?
  activeProgramId      String?
  completedWorkoutCount Int                      @default(0)
  plannedWorkoutCount  Int                       @default(0)
  sourceVersion        BigInt
  version              Int                       @default(1)
  calculatedAt         DateTime
  expiresAt            DateTime
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate, timezone])
  @@index([userId, localDate])
  @@index([state, expiresAt])
}

model Notification {
  id           String              @id @default(uuid())
  user         User                @relation(fields: [userId], references: [id])
  userId       String
  type         NotificationType
  scheduleDays Json
  scheduleTime String
  timezone     String
  status       NotificationStatus  @default(ACTIVE)
  source       NotificationSource
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([userId, type, source])
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([userId, key])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?
  type        String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
}

model Role {
  id          String     @id @default(uuid())
  code        String     @unique @db.VarChar(64)
  name        String     @db.VarChar(128)
  description String?
  createdAt   DateTime   @default(now())
  userRoles   UserRole[]
}

model UserRole {
  userId        String
  roleId        String
  assignedById  String?
  createdAt     DateTime   @default(now())

  user          User       @relation(fields: [userId], references: [id])
  role          Role       @relation(fields: [roleId], references: [id])
  assignedBy    User?      @relation("assignedByUser", fields: [assignedById], references: [id])

  @@id([userId, roleId])
}

model AuthSession {
  id               String    @id @default(uuid())
  user             User      @relation(fields: [userId], references: [id])
  userId           String
  refreshTokenHash String    @db.VarChar(255)
  ipHash           String?   @db.VarChar(255)
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?   @db.VarChar(128)
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([refreshTokenHash])
}

model AuditLog {
  id            String    @id @default(uuid())
  actorUserId   String?   
  targetUserId  String?
  action        String    @db.VarChar(128)
  entityType    String    @db.VarChar(128)
  entityId      String?
  metadata      Json      @default("{}")
  requestId     String?   @db.VarChar(128)
  ipHash        String?   @db.VarChar(255)
  createdAt     DateTime  @default(now())

  actorUser     User?     @relation("actorUser", fields: [actorUserId], references: [id])
  targetUser    User?     @relation("targetUser", fields: [targetUserId], references: [id])
}
