# Supabase connection pooler URL for the application (port 6543).
# Add ?pgbouncer=true&connection_limit=1 for Prisma transaction pooling.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct Supabase database URL for Prisma migrations (port 5432).
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
TELEGRAM_BOT_TOKEN=your_bot_token
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
AUTH_RATE_LIMIT_TELEGRAM_PER_IP=10
AUTH_RATE_LIMIT_TELEGRAM_PER_USER=5
AUTH_RATE_LIMIT_REFRESH_PER_IP=20
AUTH_RATE_LIMIT_REFRESH_PER_SESSION=20
AUTH_RATE_LIMIT_PROFILE_PER_USER=30
ONBOARDING_FALLBACK_ENABLED=true
